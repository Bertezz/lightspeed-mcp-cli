# Settings may also use a LIGHTSPEED_ prefix (e.g. LIGHTSPEED_LOG_LEVEL), which
# takes priority over the bare name. Empty values fall back to defaults.
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# API key for the OpenAI-compatible endpoint. Optional for local engines
# (Ollama, vLLM) that do not check keys.
OPENAI_API_KEY=

# Base URL of the OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1

# Model used when none is specified on the command line.
DEFAULT_MODEL=gpt-4o-mini

# Request timeout in seconds (0 < value <= 600).
REQUEST_TIMEOUT=30

# How many request -> tool -> request rounds one question may take (1-20).
MAX_TOOL_ITERATIONS=5

# How often a failed request to the model server is retried (0-10).
LLM_MAX_RETRIES=2

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
